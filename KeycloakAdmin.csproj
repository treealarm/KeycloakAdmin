<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <GeneratePackageOnBuild>True</GeneratePackageOnBuild>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Keycloak.Net.Core" Version="1.0.40" />
    <PackageReference Include="Microsoft.IdentityModel.Tokens" Version="8.22.0" />
  </ItemGroup>

  <PropertyGroup>
    <PackageId>KeycloakAdmin</PackageId>
    <Version>1.1.0</Version>
    <Authors>Danil Serov</Authors>
    <Company>TreeAlarm</Company>
    <Description>A .NET library for interacting with Keycloak basic functions.</Description>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <RepositoryUrl>https://github.com/treealarm/KeycloakAdmin</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <PackageProjectUrl>https://github.com/treealarm/KeycloakAdmin</PackageProjectUrl>
    <PackageIcon></PackageIcon>
    <Title>Keycloak Admin Client Library</Title>
  </PropertyGroup>

  <ItemGroup>
    <None Include="README.md" Pack="true" PackagePath="" />
  </ItemGroup>
</Project>
